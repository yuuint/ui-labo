{
  "name": "@ynetlabo/ui-core",
  "version": "0.1.3",
  "description": "ui-labo のプレーン Web 実装。素の Custom Elements で書き、第三者ライブラリを使わない",
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "ynetlabo",
    "url": "https://ynetlabo.net"
  },
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./prefecture-picker": "./src/components/prefecture-picker/yn-prefecture-picker.js"
  },
  "files": [
    "src"
  ],
  "ynetlabo": {
    "externalDeps": "workspace-only"
  },
  "dependencies": {
    "@ynetlabo/ui-data": "^0.1.3",
    "@ynetlabo/ui-tokens": "^0.1.3"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "homepage": "https://ui.ynetlabo.net/",
  "bugs": {
    "url": "https://github.com/yuuint/ui-labo/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yuuint/ui-labo.git",
    "directory": "packages/core"
  },
  "keywords": [
    "web-components",
    "custom-elements",
    "design-system",
    "japan",
    "prefecture",
    "ui-labo",
    "ynetlabo"
  ],
  "sideEffects": [
    "./src/index.js",
    "./src/components/**/*.js"
  ]
}
