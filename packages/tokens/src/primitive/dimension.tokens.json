{
  "$description": "素材。寸法・角丸・線幅",
  "space": {
    "$type": "dimension",
    "0":  { "$value": { "value": 0,  "unit": "px" } },
    "1":  { "$value": { "value": 2,  "unit": "px" } },
    "2":  { "$value": { "value": 4,  "unit": "px" } },
    "3":  { "$value": { "value": 6,  "unit": "px" } },
    "4":  { "$value": { "value": 8,  "unit": "px" } },
    "5":  { "$value": { "value": 10, "unit": "px" } },
    "6":  { "$value": { "value": 12, "unit": "px" } },
    "8":  { "$value": { "value": 16, "unit": "px" } },
    "10": { "$value": { "value": 20, "unit": "px" } },
    "12": { "$value": { "value": 24, "unit": "px" } }
  },
  "radius": {
    "$type": "dimension",
    "sm":   { "$value": { "value": 6,  "unit": "px" } },
    "md":   { "$value": { "value": 8,  "unit": "px" } },
    "lg":   { "$value": { "value": 14, "unit": "px" } },
    "xl":   { "$value": { "value": 18, "unit": "px" } },
    "full": { "$value": { "value": 999, "unit": "px" } }
  },
  "stroke": {
    "$type": "dimension",
    "hair":   { "$value": { "value": 1,   "unit": "px" } },
    "thin":   { "$value": { "value": 3.4, "unit": "px" } },
    "medium": { "$value": { "value": 4.5, "unit": "px" } },
    "thick":  { "$value": { "value": 8.5, "unit": "px" } }
  },
  "size": {
    "$type": "dimension",
    "field":  { "$value": { "value": 38, "unit": "px" } },
    "touch":  { "$value": { "value": 44, "unit": "px" } },
    "popMin": { "$value": { "value": 272, "unit": "px" } },
    "popMax": { "$value": { "value": 420, "unit": "px" } }
  },
  "duration": {
    "$type": "duration",
    "pop":   { "$value": { "value": 170, "unit": "ms" } },
    "sheet": { "$value": { "value": 300, "unit": "ms" } },
    "zoom":  { "$value": { "value": 520, "unit": "ms" } }
  }
}
