  "types": "./dist/prefectures.d.ts",
  "files": [
    "dist",
    "src",
    "NOTICE"
  ],
  "ynetlabo": {
    "externalDeps": "none"
  },
  "scripts": {
    "sync:data": "node scripts/sync-data.mjs",
    "sync:geo": "node scripts/sync-geo.mjs",
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "exports": {
    ".": "./dist/prefectures.js",
