{
  "name": "@ynetlabo/ui-data",
  "version": "0.1.4",
  "description": "ui-labo が 4 プラットフォームで共有するマスタデータ（都道府県・日本地図）",
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "ynetlabo",
    "url": "https://ynetlabo.net"
  },
