    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yuuint/ui-labo.git",
    "directory": "packages/data"
  },
  "keywords": [
    "japan",
    "prefecture",
    "todofuken",
    "geojson",
    "svg",
    "ui-labo",
    "ynetlabo"
